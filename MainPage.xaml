<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CurriculoMaui.MainPage"
             Title="Meu Currículo"
             BackgroundColor="#F1F5F9">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Shadow">
                <Shadow Brush="Black" Opacity="0.08" Radius="8" Offset="0,2" />
            </Setter>
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1E3A8A" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Texto" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="LineHeight" Value="1.3" />
        </Style>
        <Style x:Key="Item" TargetType="Label" BasedOn="{StaticResource Texto}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#DBEAFE" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="TagTexto" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#1E3A8A" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="0,0,0,24">

            <!-- 1 - Informações Pessoais -->
            <Border BackgroundColor="#1E3A8A" StrokeThickness="0" Padding="20,28">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border WidthRequest="130" HeightRequest="130"
                            StrokeShape="Ellipse" Stroke="White" StrokeThickness="4"
                            HorizontalOptions="Center">
                        <Image Source="perfil.png" Aspect="AspectFill"
                               SemanticProperties.Description="Foto de perfil ilustrativa" />
                    </Border>
                    <Label Text="Lucas Andrade Ferreira" FontSize="24" FontAttributes="Bold"
                           TextColor="White" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                    <Label Text="Estudante de Engenharia de Software" FontSize="15"
                           TextColor="#BFDBFE" HorizontalTextAlignment="Center" />
                    <Label Text="21 anos  •  Curitiba / PR" FontSize="14"
                           TextColor="White" HorizontalTextAlignment="Center" />
                    <Label Text="lucas.ferreira@email.com  •  (41) 99876-5432" FontSize="12"
                           TextColor="#BFDBFE" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="14" Padding="16,0">

                <!-- 2 - Resumo Profissional -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Resumo Profissional" Style="{StaticResource Titulo}" />
                        <Label Style="{StaticResource Texto}"
                               Text="Estudante do 5º período de Engenharia de Software, apaixonado por tecnologia e desenvolvimento de aplicações mobile e web. Sou proativo, organizado e tenho facilidade para aprender novas ferramentas. Gosto de trabalhar em equipe, resolver problemas e transformar ideias em soluções funcionais e bem estruturadas." />
                    </VerticalStackLayout>
                </Border>

                <!-- 3 - Objetivo -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Objetivo" Style="{StaticResource Titulo}" />
                        <Label Style="{StaticResource Texto}"
                               Text="Conquistar uma vaga de estágio ou posição júnior em desenvolvimento de software, com foco em aplicações mobile multiplataforma (.NET MAUI) e back-end em C#, contribuindo com projetos reais e evoluindo tecnicamente." />
                    </VerticalStackLayout>
                </Border>

                <!-- 4 - Formação Acadêmica -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Formação Acadêmica" Style="{StaticResource Titulo}" />
                        <VerticalStackLayout>
                            <Label Text="Bacharelado em Engenharia de Software" FontAttributes="Bold" Style="{StaticResource Texto}" />
                            <Label Text="Centro Universitário Tecnológico do Paraná • 2023 – 2027 (cursando)" Style="{StaticResource Texto}" FontSize="13" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Técnico em Informática" FontAttributes="Bold" Style="{StaticResource Texto}" />
                            <Label Text="Colégio Estadual Santos Dumont • 2019 – 2021 (concluído)" Style="{StaticResource Texto}" FontSize="13" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 5 - Cursos Complementares -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Cursos Complementares" Style="{StaticResource Titulo}" />
                        <Label Style="{StaticResource Item}" Text="• Desenvolvimento Mobile com .NET MAUI – 60h" />
                        <Label Style="{StaticResource Item}" Text="• Desenvolvimento em React Native – 40h" />
                        <Label Style="{StaticResource Item}" Text="• C# e Orientação a Objetos – 50h" />
                        <Label Style="{StaticResource Item}" Text="• Banco de Dados com SQL Server e MySQL – 30h" />
                        <Label Style="{StaticResource Item}" Text="• Git e GitHub na Prática – 12h" />
                        <Label Style="{StaticResource Item}" Text="• Inglês Técnico para TI – 40h" />
                    </VerticalStackLayout>
                </Border>

                <!-- 6 - Experiências & Atividades -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Experiências &amp; Atividades" Style="{StaticResource Titulo}" />
                        <VerticalStackLayout>
                            <Label Text="Monitor de Programação Java" FontAttributes="Bold" Style="{StaticResource Texto}" />
                            <Label Text="Universidade • 2024 – atual. Auxílio a alunos em lógica, POO e estruturas de dados." Style="{StaticResource Texto}" FontSize="13" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Desenvolvedor Voluntário" FontAttributes="Bold" Style="{StaticResource Texto}" />
                            <Label Text="ONG Mãos que Ajudam • 2024. Criação de app para controle de doações." Style="{StaticResource Texto}" FontSize="13" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Participante de Hackathon" FontAttributes="Bold" Style="{StaticResource Texto}" />
                            <Label Text="Hackathon Smart City Curitiba • 2025 – 2º lugar." Style="{StaticResource Texto}" FontSize="13" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 7 - Habilidades Técnicas / Ferramentas -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Habilidades Técnicas / Ferramentas" Style="{StaticResource Titulo}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Border Style="{StaticResource Tag}"><Label Text="C#" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text=".NET MAUI" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="Java" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="React Native" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="JavaScript" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="HTML/CSS" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="Git" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="MySQL" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="SQL Server" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="Visual Studio" Style="{StaticResource TagTexto}" /></Border>
                            <Border Style="{StaticResource Tag}"><Label Text="Figma" Style="{StaticResource TagTexto}" /></Border>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 8 - Futuro Acadêmico & Carreira -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Text="Futuro Acadêmico &amp; Carreira" Style="{StaticResource Titulo}" />
                        <Label Style="{StaticResource Texto}"
                               Text="Tenho interesse em seguir carreira na área de Inteligência Artificial aplicada a dispositivos móveis. Pretendo cursar uma pós-graduação em Ciência de Dados e obter certificações Microsoft (Azure e .NET)." />
                    </VerticalStackLayout>
                </Border>

                <!-- 9 - Empresas e Objetivos -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Empresas e Objetivos" Style="{StaticResource Titulo}" />
                        <Label Style="{StaticResource Texto}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Empresas de interesse: " FontAttributes="Bold" />
                                    <Span Text="Microsoft, Nubank, TOTVS e Ambev Tech." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Style="{StaticResource Texto}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Curto prazo: " FontAttributes="Bold" />
                                    <Span Text="Atuar como desenvolvedor júnior." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Style="{StaticResource Texto}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Longo prazo: " FontAttributes="Bold" />
                                    <Span Text="Tornar-me arquiteto de softwares." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Currículo fictício • Desenvolvido com .NET MAUI" FontSize="12"
                       TextColor="#94A3B8" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
